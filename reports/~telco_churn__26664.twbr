                <alias key='&quot;cable or dsl&quot;' value='Cable or DSL' />
                <alias key='&quot;fiber&quot;' value='Fiber' />
                <alias key='&quot;no internet&quot;' value='No internet' />
              </aliases>
            </column>
            <column caption='Dim 3 Value' datatype='string' name='[dim_3_value]' role='dimension' type='nominal' />
