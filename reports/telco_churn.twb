      <aliases enabled='yes' />
      <column caption='KPI Customers' datatype='integer' default-format='n#,##0;(#,##0)' name='[Calculation_1832385447329792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([exhibit_id] = &apos;05&apos;, [customers], 0))' />
      </column>
      <column caption='KPI Churners' datatype='integer' default-format='n#,##0;(#,##0)' name='[Calculation_1832385447612417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([exhibit_id] = &apos;05&apos;, [churners], 0))' />
      </column>
      <column caption='KPI Churn Rate' datatype='real' default-format='p0.0%' name='[Calculation_1832385448017922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1832385447612417] / [Calculation_1832385447329792]' />
      </column>
      <column caption='KPI Established Rate' datatype='real' default-format='p0.0%' name='[Calculation_1832385448177667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([exhibit_id] = &apos;05&apos; AND [dim_1_value] = &apos;established (4+ months)&apos;, [churners], 0))&#13;&#10;/ SUM(IIF([exhibit_id] = &apos;05&apos; AND [dim_1_value] = &apos;established (4+ months)&apos;, [customers], 0))' />
      </column>
      <column caption='KPI Lost Billing' datatype='real' name='[Calculation_1832385448280068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([exhibit_id] = &apos;08&apos; AND [dim_1_value] = &apos;all billing lost&apos;, [lost_monthly_charge], 0))' />
      </column>
      <column caption='KPI Fiber M2M Billing' datatype='real' name='[Calculation_1832385448361989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([exhibit_id] = &apos;08&apos; AND [dim_1_value] = &apos;month-to-month fiber&apos;, [lost_monthly_charge], 0))' />
      </column>
      <column caption='KPI Fiber M2M Churners' datatype='integer' default-format='n#,##0;(#,##0)' name='[Calculation_1832385448460294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([exhibit_id] = &apos;08&apos; AND [dim_1_value] = &apos;month-to-month fiber&apos;, [churners], 0))' />
      </column>
      <column caption='KPI Fiber M2M Share' datatype='real' default-format='p0.0%' name='[Calculation_1832385448554503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1832385448361989] / [Calculation_1832385448280068]' />
      </column>
      <column caption='KPI Lost Billing Label' datatype='string' name='[Calculation_1832385448640520]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// lowercase &quot;k&quot;; Tableau&apos;s display units only give &quot;K&quot;&#13;&#10;&apos;$&apos; + STR(ROUND([Calculation_1832385448280068] / 1000, 1)) + &apos;k / mo&apos;' />
      </column>
      <column caption='Focus' datatype='boolean' name='[Calculation_1832385464463369]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [exhibit_id]&#13;&#10;  WHEN &apos;01&apos; THEN [dim_1_value] = &apos;senior (65+)&apos;&#13;&#10;  WHEN &apos;03&apos; THEN [dim_1_value] = &apos;fiber optic&apos;&#13;&#10;  WHEN &apos;04&apos; THEN [dim_1_value] = &apos;fiber optic&apos;&#13;&#10;  WHEN &apos;05&apos; THEN [dim_3_value] = &apos;fiber&apos;&#13;&#10;  WHEN &apos;06&apos; THEN [dim_2_value] = &apos;senior (65+)&apos;&#13;&#10;  WHEN &apos;07&apos; THEN [dim_2_value] = &apos;fiber optic&apos;&#13;&#10;  ELSE FALSE&#13;&#10;END' />
      </column>
      <column caption='Rate label' datatype='string' name='[Calculation_1832385464766474]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([churn_rate] * 100, 1)) + &apos;%&apos; + IIF([customers] &lt; 100, &apos;*&apos;, &apos;&apos;)' />
      </column>
      <column caption='Interval label' datatype='string' name='[Calculation_1832385464926219]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([churn_rate_lower] * 100, 1)) + &apos;–&apos; + STR(ROUND([churn_rate_upper] * 100, 1)) + &apos;%&apos;' />
      </column>
      <column caption='Label Focus' datatype='real' default-format='p0.0%' name='[Calculation_1832385465180172]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// senior value: bold, primary&#13;&#10;IIF([Calculation_1832385464463369], [churn_rate], NULL)' />
      </column>
      <column caption='Label Other' datatype='real' default-format='p0.0%' name='[Calculation_1832385465430029]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// under-65 value: secondary&#13;&#10;IIF(NOT [Calculation_1832385464463369], [churn_rate], NULL)' />
      </column>
      <column caption='Gap pts' datatype='real' default-format='*+0.0&quot; pts&quot;;-0.0&quot; pts&quot;' name='[Calculation_1832385465667598]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [exhibit_id], [dim_2_value] :&#13;&#10;    MAX(IIF([Calculation_1832385464463369], [churn_rate], NULL)) - MAX(IIF(NOT [Calculation_1832385464463369], [churn_rate], NULL)) } * 100' />
      </column>
      <column caption='Mix on accent' datatype='real' default-format='p0.0%' name='[Calculation_1832385490706447]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([dim_2_value] = &apos;fiber&apos;, [share_of_dim_1_customers], NULL)' />
      </column>
      <column caption='Mix on grey' datatype='real' default-format='p0.0%' name='[Calculation_1832385490911248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([dim_2_value] = &apos;cable or dsl&apos;, [share_of_dim_1_customers], NULL)' />
      </column>
      <column caption='Mix on light' datatype='real' default-format='p0.0%' name='[Calculation_1832385490997265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([dim_2_value] = &apos;no internet&apos; AND [dim_1_value] = &apos;under 65&apos;,&#13;&#10;                      [share_of_dim_1_customers], NULL)' />
      </column>
      <column caption='Reason' datatype='string' name='[Calculation_1832385537069074]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[dim_2_value]' />
        <aliases>
          <alias key='&quot;attitude&quot;' value='Attitude' />
          <alias key='&quot;competitor&quot;' value='Competitor' />
          <alias key='&quot;dissatisfaction&quot;' value='Dissatisfaction' />
          <alias key='&quot;other&quot;' value='Other' />
          <alias key='&quot;price&quot;' value='Price' />
        </aliases>
      </column>
      <column caption='Fiber' datatype='real' default-format='p0.0%' name='[Calculation_1832385537167379]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [exhibit_id], [dim_2_value] :&#13;&#10;                    MAX(IIF([Calculation_1832385464463369], [share_of_dim_1_churners], NULL)) }' />
      </column>
      <column caption='DSL' datatype='real' default-format='p0.0%' name='[Calculation_1832385537282068]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [exhibit_id], [dim_2_value] :&#13;&#10;                    MAX(IIF(NOT [Calculation_1832385464463369], [share_of_dim_1_churners], NULL)) }' />
      </column>
      <column caption='Difference' datatype='real' default-format='*+0.0&quot; pts&quot;;−0.0&quot; pts&quot;' name='[Calculation_1832385537392661]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='(ROUND([Calculation_1832385537167379], 3) - ROUND([Calculation_1832385537282068], 3)) * 100' />
      </column>
      <column caption='Segment' datatype='string' name='[Calculation_1832385556537366]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [dim_2_value] = &apos;month-to-month&apos; THEN&#13;&#10;    IIF([dim_1_value] = &apos;new (0-3 months)&apos;, &apos;New (0–3 months)&apos;, &apos;Established&apos;)&#13;&#10;    + &apos; · month-to-month · &apos; + [dim_3_value]&#13;&#10;ELSE &apos;Committed contracts (8 segments)&apos;&#13;&#10;END' />
      </column>
      <column caption='Segment fiber' datatype='boolean' name='[Calculation_1832385556627479]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// colour at the grouped-row level&#13;&#10;[dim_2_value] = &apos;month-to-month&apos; AND [dim_3_value] = &apos;fiber&apos;' />
      </column>
      <column caption='Customers(n)' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1832385556811800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [exhibit_id], [Calculation_1832385556537366] : SUM([customers]) }' />
      </column>
      <column caption='Churn rate' datatype='real' default-format='p0.0%' name='[Calculation_1832385556910105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [exhibit_id], [Calculation_1832385556537366] : SUM([churners]) / SUM([customers]) }' />
      </column>
      <column caption='Seniors' datatype='real' default-format='p0.0%' name='[Calculation_1832385573855258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [exhibit_id], [dim_1_value] :&#13;&#10;                     MAX(IIF([Calculation_1832385464463369], [churn_rate], NULL)) }' />
      </column>
      <column caption='Under 65' datatype='real' default-format='p0.0%' name='[Calculation_1832385573949467]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [exhibit_id], [dim_1_value] :&#13;&#10;                     MAX(IIF(NOT [Calculation_1832385464463369], [churn_rate], NULL)) }' />
      </column>
      <column caption='Gap' datatype='real' default-format='*+0.0&quot; pts&quot;;−0.0&quot; pts&quot;' name='[Calculation_1832385574162460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1832385573855258] - [Calculation_1832385573949467]) * 100' />
      </column>
      <column caption='Seniors churned' datatype='string' name='[Calculation_1832385574330397]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [exhibit_id], [dim_1_value] :&#13;&#10;    MAX(IIF([Calculation_1832385464463369],&#13;&#10;        STR(INT([churners])) + &apos; of &apos; + STR(INT([customers]))&#13;&#10;        + IIF([dim_1_value] = &apos;two year&apos;,&#13;&#10;              &apos; (95% CI &apos; + STR(ROUND([churn_rate_lower] * 100, 1)) + &apos;–&apos;&#13;&#10;              + STR(ROUND([churn_rate_upper] * 100, 1)) + &apos;%)&apos;, &apos;&apos;),&#13;&#10;        NULL)) }' />
      </column>
      <column caption='CI lower' datatype='real' name='[Calculation_1832385574436894]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_1832385464463369] AND [dim_1_value] = &apos;two year&apos;, [churn_rate_lower], NULL)' />
      </column>
      <column caption='CI upper' datatype='real' name='[Calculation_1832385574641695]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_1832385464463369] AND [dim_1_value] = &apos;two year&apos;, [churn_rate_upper], NULL)' />
      </column>
      <column caption='Contract' datatype='string' name='[Calculation_1832385740427296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [dim_1_value] WHEN &apos;month-to-month&apos; THEN &apos;Month-to-month&apos;&#13;&#10;            WHEN &apos;one year&apos; THEN &apos;One year&apos; WHEN &apos;two year&apos; THEN &apos;Two year&apos; END' />
      </column>
      <column caption='Product name' datatype='string' name='[Calculation_1832385745977377]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [dim_2_value] WHEN &apos;fiber optic&apos; THEN &apos;Fiber&apos; WHEN &apos;cable&apos; THEN &apos;Cable&apos;&#13;&#10;                   WHEN &apos;dsl&apos; THEN &apos;DSL&apos; WHEN &apos;no internet&apos; THEN &apos;No internet&apos; END' />
      </column>
      <column caption='Slope F name' datatype='string' name='[Calculation_1832385746133026]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Calculation_1832385464463369] AND [dim_1_value] = &apos;established (4+ months)&apos;, [Calculation_1832385745977377] + &apos; &apos;, NULL)' />
      </column>
      <column caption='Slope O name' datatype='string' name='[Calculation_1832385746243619]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(NOT [Calculation_1832385464463369] AND [dim_1_value] = &apos;established (4+ months)&apos;, [Calculation_1832385745977377] + &apos; &apos;, NULL)' />
      </column>
      <column caption='Slope F value' datatype='real' default-format='p0.0%' name='[Calculation_1832385746366500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_1832385464463369], [churn_rate], NULL)' />
      </column>
      <column caption='Slope O value' datatype='real' default-format='p0.0%' name='[Calculation_1832385746468901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(NOT [Calculation_1832385464463369], [churn_rate], NULL)' />
      </column>
      <column caption='Lost k' datatype='real' default-format='n&quot;$&quot;#,##0.0&quot;k&quot;;(&quot;$&quot;#,##0.0&quot;k&quot;)' name='[Calculation_1832385757356070]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[lost_monthly_charge] / 1000' />
