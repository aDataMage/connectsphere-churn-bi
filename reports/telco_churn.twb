      <table>
        <view>
          <datasources>
            <datasource caption='Segments' name='federated.1y0r8hd18mva6o1fyesit0n33g04' />
          </datasources>
          <datasource-dependencies datasource='federated.1y0r8hd18mva6o1fyesit0n33g04'>
            <column caption='Focus' datatype='boolean' name='[Calculation_1832385464463369]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [exhibit_id]&#13;&#10;  WHEN &apos;01&apos; THEN [dim_1_value] = &apos;senior (65+)&apos;&#13;&#10;  WHEN &apos;03&apos; THEN [dim_1_value] = &apos;fiber optic&apos;&#13;&#10;  WHEN &apos;04&apos; THEN [dim_1_value] = &apos;fiber optic&apos;&#13;&#10;  WHEN &apos;05&apos; THEN [dim_3_value] = &apos;fiber&apos;&#13;&#10;  WHEN &apos;06&apos; THEN [dim_2_value] = &apos;senior (65+)&apos;&#13;&#10;  WHEN &apos;07&apos; THEN [dim_2_value] = &apos;fiber optic&apos;&#13;&#10;  ELSE FALSE&#13;&#10;END' />
            </column>
            <column caption='Rate label' datatype='string' name='[Calculation_1832385464766474]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(ROUND([churn_rate] * 100, 1)) + &apos;%&apos; + IIF([customers] &lt; 100, &apos;*&apos;, &apos;&apos;)' />
            </column>
            <column caption='Interval label' datatype='string' name='[Calculation_1832385464926219]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(ROUND([churn_rate_lower] * 100, 1)) + &apos;–&apos; + STR(ROUND([churn_rate_upper] * 100, 1)) + &apos;%&apos;' />
            </column>
            <column caption='Label Focus' datatype='real' default-format='p0.0%' name='[Calculation_1832385465180172]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// senior value: bold, primary&#13;&#10;IIF([Calculation_1832385464463369], [churn_rate], NULL)' />
            </column>
            <column caption='Label Other' datatype='real' default-format='p0.0%' name='[Calculation_1832385465430029]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// under-65 value: secondary&#13;&#10;IIF(NOT [Calculation_1832385464463369], [churn_rate], NULL)' />
            </column>
            <column caption='Gap pts' datatype='real' default-format='*+0.0&quot; pts&quot;;-0.0&quot; pts&quot;' name='[Calculation_1832385465667598]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [exhibit_id], [dim_2_value] :&#13;&#10;    MAX(IIF([Calculation_1832385464463369], [churn_rate], NULL)) - MAX(IIF(NOT [Calculation_1832385464463369], [churn_rate], NULL)) } * 100' />
            </column>
            <column-instance column='[Calculation_1832385464766474]' derivation='Attribute' name='[attr:Calculation_1832385464766474:nk]' pivot='key' type='nominal' />
