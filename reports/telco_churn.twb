    <worksheet name='EX06 Contract x Age'>
      <table>
        <view>
          <datasources>
            <datasource caption='Segments' name='federated.1y0r8hd18mva6o1fyesit0n33g04' />
          </datasources>
          <datasource-dependencies datasource='federated.1y0r8hd18mva6o1fyesit0n33g04'>
            <column caption='Focus' datatype='boolean' name='[Calculation_1832385464463369]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [exhibit_id]&#13;&#10;  WHEN &apos;01&apos; THEN [dim_1_value] = &apos;senior (65+)&apos;&#13;&#10;  WHEN &apos;03&apos; THEN [dim_1_value] = &apos;fiber optic&apos;&#13;&#10;  WHEN &apos;04&apos; THEN [dim_1_value] = &apos;fiber optic&apos;&#13;&#10;  WHEN &apos;05&apos; THEN [dim_3_value] = &apos;fiber&apos;&#13;&#10;  WHEN &apos;06&apos; THEN [dim_2_value] = &apos;senior (65+)&apos;&#13;&#10;  WHEN &apos;07&apos; THEN [dim_2_value] = &apos;fiber optic&apos;&#13;&#10;  ELSE FALSE&#13;&#10;END' />
            </column>
            <column caption='Rate label' datatype='string' name='[Calculation_1832385464766474]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(ROUND([churn_rate] * 100, 1)) + &apos;%&apos; + IIF([customers] &lt; 100, &apos;*&apos;, &apos;&apos;)' />
            </column>
            <column caption='Interval label' datatype='string' name='[Calculation_1832385464926219]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(ROUND([churn_rate_lower] * 100, 1)) + &apos;–&apos; + STR(ROUND([churn_rate_upper] * 100, 1)) + &apos;%&apos;' />
            </column>
            <column caption='Seniors' datatype='real' default-format='p0.0%' name='[Calculation_1832385573855258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [exhibit_id], [dim_1_value] :&#13;&#10;                     MAX(IIF([Calculation_1832385464463369], [churn_rate], NULL)) }' />
            </column>
            <column caption='Under 65' datatype='real' default-format='p0.0%' name='[Calculation_1832385573949467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [exhibit_id], [dim_1_value] :&#13;&#10;                     MAX(IIF(NOT [Calculation_1832385464463369], [churn_rate], NULL)) }' />
            </column>
            <column caption='Gap' datatype='real' default-format='*+0.0&quot; pts&quot;;−0.0&quot; pts&quot;' name='[Calculation_1832385574162460]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1832385573855258] - [Calculation_1832385573949467]) * 100' />
            </column>
            <column caption='Seniors churned' datatype='string' name='[Calculation_1832385574330397]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [exhibit_id], [dim_1_value] :&#13;&#10;    MAX(IIF([Calculation_1832385464463369],&#13;&#10;        STR(INT([churners])) + &apos; of &apos; + STR(INT([customers]))&#13;&#10;        + IIF([dim_1_value] = &apos;two year&apos;,&#13;&#10;              &apos; (95% CI &apos; + STR(ROUND([churn_rate_lower] * 100, 1)) + &apos;–&apos;&#13;&#10;              + STR(ROUND([churn_rate_upper] * 100, 1)) + &apos;%)&apos;, &apos;&apos;),&#13;&#10;        NULL)) }' />
            </column>
            <column caption='CI lower' datatype='real' name='[Calculation_1832385574436894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_1832385464463369] AND [dim_1_value] = &apos;two year&apos;, [churn_rate_lower], NULL)' />
            </column>
            <column caption='CI upper' datatype='real' name='[Calculation_1832385574641695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_1832385464463369] AND [dim_1_value] = &apos;two year&apos;, [churn_rate_upper], NULL)' />
            </column>
            <column caption='Contract' datatype='string' name='[Calculation_1832385740427296]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [dim_1_value] WHEN &apos;month-to-month&apos; THEN &apos;Month-to-month&apos;&#13;&#10;            WHEN &apos;one year&apos; THEN &apos;One year&apos; WHEN &apos;two year&apos; THEN &apos;Two year&apos; END' />
            </column>
            <column-instance column='[Calculation_1832385464766474]' derivation='Attribute' name='[attr:Calculation_1832385464766474:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1832385464926219]' derivation='Attribute' name='[attr:Calculation_1832385464926219:nk]' pivot='key' type='nominal' />
            <column-instance column='[dim_2_value]' derivation='Attribute' name='[attr:dim_2_value:nk]' pivot='key' type='nominal' />
