    <worksheet name='EX02 Product Mix'>
      <table>
        <view>
          <datasources>
            <datasource caption='Segments' name='federated.1y0r8hd18mva6o1fyesit0n33g04' />
          </datasources>
          <datasource-dependencies datasource='federated.1y0r8hd18mva6o1fyesit0n33g04'>
            <column caption='Mix on accent' datatype='real' default-format='p0.0%' name='[Calculation_1832385490706447]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([dim_2_value] = &apos;fiber&apos;, [share_of_dim_1_customers], NULL)' />
            </column>
            <column caption='Mix on grey' datatype='real' default-format='p0.0%' name='[Calculation_1832385490911248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([dim_2_value] = &apos;cable or dsl&apos;, [share_of_dim_1_customers], NULL)' />
            </column>
            <column caption='Mix on light' datatype='real' default-format='p0.0%' name='[Calculation_1832385490997265]' role='measure' type='quantitative'>
