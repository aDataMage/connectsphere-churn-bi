              <calculation class='tableau' formula='IF [dim_2_value] = &apos;month-to-month&apos; THEN&#13;&#10;    IIF([dim_1_value] = &apos;new (0-3 months)&apos;, &apos;New (0–3 months)&apos;, &apos;Established&apos;)&#13;&#10;    + &apos; · month-to-month · &apos; + [dim_3_value]&#13;&#10;ELSE &apos;Committed contracts (8 segments)&apos;&#13;&#10;END' />
