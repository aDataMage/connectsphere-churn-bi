              <flipboard active-id='10' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Fiber on month-to-month is two-thirds of the billing lost to churn' captured-sheet='SP1 Setting' id='1' />
                  <story-point caption='Seniors churn at about twice the rate, at every stage of tenure.' captured-sheet='SP2 Interruption' id='2' />
                  <story-point caption='Seven in ten seniors are on fiber' captured-sheet='SP3 Seniors on Fiber' id='3' />
                  <story-point caption='At the same price, fiber churns far more than DSL' captured-sheet='SP4 Same Price' id='4' />
                  <story-point caption='Fiber churners name a competitor, not price' captured-sheet='SP5 Competitor Not Price' id='5' />
                  <story-point caption='Four month-to-month segments hold 88.6% of all churn' captured-sheet='SP6 Where Churn Sits' id='6' />
                  <story-point caption='Senior fiber customers churn at 78% on month-to-month, 1% on two-year' captured-sheet='SP7 Contract' id='7' />
                  <story-point caption='The same customers leave from the first month, only faster' captured-sheet='SP8 First Months' id='8' />
                  <story-point caption='About $37,000 a month is specific to fiber' captured-sheet='SP9 Cost' id='9' />
                  <story-point caption='Three decisions, three owners' captured-sheet='SP10 Asks' id='10'>
                    <currentDeltas>
                      <dashboard name='SP10 Asks'>
                        <zone id='17'>
                          <formatted-text>
                            <run bold='true' fontcolor='#4cc2a5' fontsize='16'>3.</run>
                            <run fontcolor='#f2f6fa' fontsize='16'> Test a one-year contract offer on month-to-month fiber, with a holdout group</run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#8fa6bc' fontsize='11'>Starting with senior fiber customers. Committed fiber customers churn at about a third of the month-to-month rate (16.8% vs 53.3%), but customers choose their contracts. Only a test separates the two explanations.</run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#8fa6bc' fontsize='11'>Owner: Head of Data and Analytics · Decide by 12ᵗʰ  October, 2026</run>
                          </formatted-text>
                        </zone>
                      </dashboard>
                    </currentDeltas>
                    <capturedDeltas>
                      <dashboard name='SP10 Asks'>
                        <zone id='18'>
                          <formatted-text>
                            <run fontcolor='#f2f6fa' fontsize='12' italic='true'>The twist: fiber customers on a lower bill churn more, not less.</run>
                          </formatted-text>
                        </zone>
                      </dashboard>
                    </capturedDeltas>
                  </story-point>
                </story-points>
              </flipboard>
