            <column aggregation='Sum' caption='Dim 1 Sort' datatype='integer' name='[dim_1_sort]' role='dimension' type='ordinal' />
            <column caption='Dim 1 Value' datatype='string' name='[dim_1_value]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;established (4+ months)&quot;' value='Established (4+ months)' />
                <alias key='&quot;month-to-month&quot;' value='Month-to-Month' />
                <alias key='&quot;new (0-3 months)&quot;' value='First three months' />
                <alias key='&quot;one year&quot;' value='One year' />
                <alias key='&quot;senior (65+)&quot;' value='Senior (65+)‎ ‎ ‎ ‎ ' />
                <alias key='&quot;two year&quot;' value='Two year' />
                <alias key='&quot;under 65&quot;' value='Under 65‎ ‎ ‎ ‎ ' />
              </aliases>
            </column>
            <column caption='Dim 2 Value' datatype='string' name='[dim_2_value]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;$58-75&quot;' value='$58‒75' />
                <alias key='&quot;$75-88&quot;' value='$75−88' />
                <alias key='&quot;$88-100&quot;' value='$88–100' />
                <alias key='&quot;13-24&quot;' value='13-24 months' />
                <alias key='&quot;25-48&quot;' value='25-48 months' />
